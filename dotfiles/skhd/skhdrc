# space navigation
ctrl + alt + cmd - left  : yabai -m space --focus prev
ctrl + alt + cmd - right : yabai -m space --focus next

ctrl + alt + cmd + shift - left  : yabai -m window --space prev; yabai -m space --focus prev
ctrl + alt + cmd + shift - right : yabai -m window --space next; yabai -m space --focus next

# display focus
ctrl + alt + cmd - down : yabai -m display --focus next
ctrl + alt + cmd - up   : yabai -m display --focus prev
ctrl + alt + cmd - 0x30 : yabai -m display --focus next        # tab (wrap)

ctrl + alt + cmd + shift - down : yabai -m window --display next; yabai -m display --focus next
ctrl + alt + cmd + shift - up   : yabai -m window --display prev; yabai -m display --focus prev

# layout toggle
ctrl + alt + cmd - m : $HOME/.config/yabai/toggle-layout.sh

# window focus (j/k/l/i = left/down/right/up)
ctrl + alt + cmd - j : yabai -m window --focus west
ctrl + alt + cmd - k : yabai -m window --focus south
ctrl + alt + cmd - l : yabai -m window --focus east
ctrl + alt + cmd - i : yabai -m window --focus north

# window move/swap
ctrl + alt + cmd + shift - j : yabai -m window --swap west
ctrl + alt + cmd + shift - k : yabai -m window --swap south
ctrl + alt + cmd + shift - l : yabai -m window --swap east
ctrl + alt + cmd + shift - i : yabai -m window --swap north

# resize (aerospace resize smart +-50)
ctrl + alt + cmd - 0x1B : yabai -m window --resize right:-50:0 || yabai -m window --resize left:-50:0   # minus
ctrl + alt + cmd - 0x18 : yabai -m window --resize right:50:0  || yabai -m window --resize left:50:0    # equal
