{
  "name": "@mokyabun/dotori",
  "version": "0.1.0",
  "description": "A Bun-powered library for procedural, declarative macOS setup",
  "keywords": [
    "bun",
    "dotfiles",
    "macos",
    "setup"
  ],
  "homepage": "https://github.com/mokyabun/dotori#readme",
  "bugs": {
    "url": "https://github.com/mokyabun/dotori/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokyabun/dotori.git"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bunup src/index.ts --target=bun --sourcemap=external --dts.infer-types",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run test",
    "prepack": "bun run check && bun run build",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --fix"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "latest",
    "@types/plist": "^3.0.5",
    "bunup": "^0.16.32",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "picocolors": "^1.1.1",
    "plist": "^5.0.0",
    "zod": "^4.4.3"
  }
}
